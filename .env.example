# ── App ───────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000

# ── Database (PostgreSQL + PostGIS) ─────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/discover_georgia

# ── Authentication (Auth.js) ────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# Optional — only needed once Google OAuth is added alongside Credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Maps provider (abstracted behind MapProvider — see src/lib/providers/maps) ─
# NEXT_PUBLIC_ because the client-side map component needs it directly.
# Restrict by HTTP referrer in Google Cloud Console — see docs/architecture.md §5.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Server-side key for the Geocoding API (MapProvider). Should be a separate,
# IP-restricted key in production — not the same value as the client key above.
GOOGLE_MAPS_SERVER_API_KEY=

# ── Routing provider (abstracted behind RoutingProvider) ───────────────
# Defaults to Google Directions API; swappable without touching RouteService.
ROUTING_PROVIDER=google
ROUTING_PROVIDER_API_KEY=

# ── Object storage (abstracted behind StorageProvider) ──────────────────
STORAGE_PROVIDER=r2
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=discover-georgia-media
STORAGE_PUBLIC_BASE_URL=

# ── Video CDN / streaming provider (abstracted behind VideoProvider) ───
VIDEO_PROVIDER=mux
VIDEO_PROVIDER_TOKEN_ID=
VIDEO_PROVIDER_TOKEN_SECRET=

# ── AI (abstracted behind AIProvider — never exposed to the client) ────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# ── Telegram (TelegramService) ──────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
ADMIN_CHAT_ID=

# ── Rate limiting / caching (optional, Phase 12) ────────────────────────
REDIS_URL=
